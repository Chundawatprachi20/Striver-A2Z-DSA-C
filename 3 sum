#include <stdio.h>

int main()
{
    int arr[] = {-1, 0, 1, 2, -1, -4};
    int n = 6;

    int i, j, k;

    for(i = 0; i < n - 2; i++)
    {
        for(j = i + 1; j < n - 1; j++)
        {
            for(k = j + 1; k < n; k++)
            {
                if(arr[i] + arr[j] + arr[k] == 0)
                {
                    printf("%d %d %d\n",
                           arr[i], arr[j], arr[k]);
                }
            }
        }
    }

    return 0;
}
