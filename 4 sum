#include <stdio.h>

int main()
{
    int arr[] = {-1, 0, 1, 2, -1, -4};
    int n = 6;

    int i, j, k, l;

    for(i = 0; i < n - 3; i++)
    {
        for(j = i + 1; j < n - 2; j++)
        {
            for(k = j + 1; k < n - 1; k++)
            {
                for(l = k + 1; l < n; l++)
                {
                    if(arr[i] + arr[j] + arr[k] + arr[l] == 0)
                    {
                        printf("%d %d %d %d\n",
                               arr[i], arr[j], arr[k], arr[l]);
                    }
                }
            }
        }
    }

    return 0;
}
