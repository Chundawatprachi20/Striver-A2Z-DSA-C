class Solution {
public:
    long long numberOfInversions(vector<int>& a) {
        
        int n = a.size();
        long long count = 0;

        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                
                if (a[i] > a[j]) {
                    count++;
                }
            }
        }

        return count;
    }
};
