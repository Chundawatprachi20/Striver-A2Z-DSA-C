#include <stdio.h>

int lowerbound(int arr[],int n,int target)
{
    int low =0;
    int high =n-1;
    int ans =n;
    int mid;
    while(low<= high )
    {
        mid= (low+high)/2;
        if (arr[mid]>= target)
        {
        ans=mid;
        high = mid -1;
    }
    else 
    {
        low = mid +1;
    }
}
return ans;
}
int main ()
{
    int arr[6]={1,2,3,4,5,6,7};
    int n=6;
    int target=2;
    scanf (" %d ", &n);
    printf(" %d ",  lowerbound(arr,n,target));

return 0;
}
