#include <stdio.h>

int main()
{
    int arr[] = {9, -3, 3, -1, 6, -5};
    int n = 6;

    int i, j;
    int sum, len, maxLen = 0;

    for(i = 0; i < n; i++)
    {
        sum = 0;

        for(j = i; j < n; j++)
        {
            sum = sum + arr[j];

            if(sum == 0)
            {
                len = j - i + 1;

                if(len > maxLen)
                {
                    maxLen = len;
                }
            }
        }
    }

    printf("Length of longest subarray with sum 0 = %d", maxLen);

    return 0;
}
